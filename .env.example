# ---- Core ----
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# ---- Database ----
# Local Mongo or Atlas. DB name is appended in config/db.js if absent.
MONGODB_URI=mongodb://127.0.0.1:27017/hallelAquaCareDB

# ---- Sessions ----
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Seeded admin (created on first startup if no users exist) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Hallel Admin

# ---- Hubtel payments (fill when docs arrive) ----
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_CALLBACK_URL=http://localhost:3000/payment/callback

# ---- Hubtel SMS (notifications) ----
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=HallelAqua

# ---- Distance provider (haversine | google). Google needs the key below. ----
DISTANCE_PROVIDER=haversine
GOOGLE_MAPS_API_KEY=
