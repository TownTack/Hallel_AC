<%
  const st = booking.payment.status;
  const badge = st === 'paid' ? 'bg-success' : (st === 'deposit_paid' ? 'bg-warning text-dark' : 'bg-danger');
%>
<div class="modal-header">
  <h5 class="modal-title"><%= booking.clientName %>
    <span class="badge <%= badge %> ms-2"><%= st.replace('_',' ') %></span>
    <small class="text-muted ms-2">Ref <%= booking.reference || String(booking._id).slice(-6).toUpperCase() %></small>
  </h5>
  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body" data-id="<%= booking._id %>">
  <div class="row g-3">
    <div class="col-md-6">
      <h6 class="section-title">Client</h6>
      <div class="small">
        <div>WhatsApp: <strong><%= booking.whatsapp %></strong></div>
        <% if (booking.email) { %><div>Email: <%= booking.email %></div><% } %>
        <div>Address: <%= booking.location.address || '—' %></div>
        <div>Distance: <%= booking.location.distanceKm != null ? booking.location.distanceKm + ' km' : '—' %></div>
      </div>
    </div>
    <div class="col-md-6">
      <h6 class="section-title">Service</h6>
      <div class="small">
        <div>Date: <strong><%= new Date(booking.bookingDate).toLocaleDateString('en-GB') %></strong></div>
        <div>Tier: <%= booking.serviceTier === 'preserve' ? 'Clean & Preserve' : 'Standard Clean' %></div>
        <ul class="mb-1 ps-3">
          <% booking.tanks.forEach(t => { %><li><%= t.quantity %>× <%= t.label %> — GHS <%= t.lineTotal.toFixed(2) %></li><% }) %>
        </ul>
      </div>
    </div>
  </div>

  <hr />
  <% const isHubtel = booking.payment.method === 'hubtel'; %>
  <% const hubtelPaid = !!(booking.payment.hubtel && booking.payment.hubtel.transactionId); %>
  <div class="row small">
    <div class="col-6">Payment method</div><div class="col-6 text-end"><%= isHubtel ? 'Hubtel (online)' : 'Cash / pay on-site' %></div>
    <div class="col-6">Tanks subtotal</div><div class="col-6 text-end">GHS <%= booking.pricing.tanksSubtotal.toFixed(2) %></div>
    <div class="col-6">Transport</div><div class="col-6 text-end"><%= booking.transport.free ? 'Free' : 'GHS ' + booking.transport.fee.toFixed(2) %></div>
    <div class="col-6 fw-bold">Total</div>
    <div class="col-6 text-end fw-bold"><%= booking.pricing.customPending ? 'Custom quote required' : 'GHS ' + booking.pricing.total.toFixed(2) %></div>

    <% if (booking.payment.status !== 'unpaid') { %>
      <% const withFees = hubtelPaid && booking.payment.status === 'deposit_paid' && booking.payment.hubtel.amount != null && booking.payment.amountPaid > booking.payment.hubtel.amount; %>
      <div class="col-6 text-muted mt-1">Paid</div>
      <div class="col-6 text-end text-muted mt-1">GHS <%= booking.payment.amountPaid.toFixed(2) %><% if (withFees) { %> (with fees)<% } %> (due GHS <%= booking.payment.amountDue.toFixed(2) %>)</div>
      <% if (hubtelPaid) { %>
        <% const hubtelAmt = booking.payment.hubtel.amount != null ? booking.payment.hubtel.amount : booking.payment.amountPaid; %>
        <div class="col-12 text-muted">Received from Hubtel: GHS <%= hubtelAmt.toFixed(2) %> (txn <%= booking.payment.hubtel.transactionId %>).</div>
      <% } %>
      <div class="col-6 fw-bold mt-1">Confirmed</div>
      <div class="col-6 text-end mt-1">
        <span class="badge <%= booking.payment.confirmedManually ? 'bg-success' : 'bg-secondary' %>"><%= booking.payment.confirmedManually ? 'Yes' : 'No' %></span>
      </div>
      <% if (booking.payment.confirmedManually) { %>
        <div class="col-12 text-muted">Confirmed by <%= booking.payment.confirmedBy %> on <%= new Date(booking.payment.confirmedAt).toLocaleString('en-GB') %></div>
      <% } else if (hubtelPaid) { %>
        <% if (booking.payment.status === 'deposit_paid') { %>
          <div class="col-12 text-muted">Deposit received via Hubtel — collect the balance on-site, then Confirm full payment to finalise.</div>
        <% } else { %>
          <div class="col-12 text-muted">Paid via Hubtel — check your phone, then confirm to finalise.</div>
        <% } %>
      <% } else { %>
        <div class="col-12 text-muted">Awaiting your confirmation.</div>
      <% } %>
    <% } else { %>
      <div class="col-6 text-muted mt-1">Paid</div><div class="col-6 text-end text-muted mt-1">GHS 0.00</div>
      <div class="col-12 text-muted"><%= isHubtel ? 'Awaiting Hubtel payment.' : 'Awaiting cash payment confirmation by admin.' %></div>
    <% } %>
  </div>

  <hr />
  <!-- Actions -->
  <div class="d-flex flex-wrap gap-2 mb-3">
    <% if (!booking.pricing.customPending) { %>
      <% if (hubtelPaid) { %>
        <%# Money received via Hubtel (deposit or full). Confirming collects any
            on-site balance and finalises the FULL amount. %>
        <% if (!booking.payment.confirmedManually) { %>
          <button class="btn btn-sm btn-success js-pay" data-mode="confirm"><%= booking.payment.status === 'deposit_paid' ? 'Confirm full payment' : 'Confirm payment' %></button>
        <% } else { %>
          <button class="btn btn-sm btn-outline-danger js-pay" data-mode="unconfirm">Undo confirmation</button>
        <% } %>
      <% } else if (booking.payment.status === 'unpaid') { %>
        <button class="btn btn-sm btn-success js-pay" data-mode="full">Confirm full payment</button>
        <% if (!booking.transport.free) { %>
          <button class="btn btn-sm btn-outline-warning js-pay" data-mode="deposit">Confirm deposit only</button>
        <% } %>
      <% } else { %>
        <button class="btn btn-sm btn-outline-danger js-pay" data-mode="reset">Undo payment confirmation</button>
      <% } %>
    <% } %>
    <button class="btn btn-sm <%= booking.jobCompleted ? 'btn-secondary' : 'btn-outline-primary' %> js-job">
      <%= booking.jobCompleted ? 'Mark job pending' : 'Mark job completed' %>
    </button>
    <a class="btn btn-sm btn-outline-dark" href="/admin/bookings/<%= booking._id %>/receipt" target="_blank">Generate receipt</a>
    <a class="btn btn-sm btn-outline-dark" href="/admin/bookings/<%= booking._id %>/certificate" target="_blank">Generate certificate</a>
  </div>

  <!-- Settle custom quote — available whenever the booking has a custom-priced tank,
       so a mistaken price can be corrected after it's first settled. -->
  <% if (booking.tanks.some(t => t.custom)) { %>
    <div class="card p-3 mb-3 border-warning">
      <h6 class="section-title text-warning-emphasis"><%= booking.pricing.customPending ? 'Settle custom quote' : 'Edit custom price' %></h6>
      <p class="small text-muted"><%= booking.pricing.customPending
        ? 'Enter the agreed unit price for each custom tank (after phoning the client), then save to finalise the total.'
        : 'Update the agreed unit price for any custom tank and save to recalculate the total.' %></p>
      <form class="row g-2 js-settle">
        <% booking.tanks.forEach((t, i) => { %>
          <% if (t.custom) { %>
            <div class="col-md-8 d-flex align-items-center small"><%= t.quantity %>× <%= t.label %></div>
            <div class="col-md-4">
              <div class="input-group input-group-sm">
                <span class="input-group-text">GHS</span>
                <input name="price_<%= i %>" type="number" step="any" min="0" class="form-control form-control-sm" value="<%= t.unitPrice %>" required />
                <span class="input-group-text">/ tank</span>
              </div>
            </div>
          <% } %>
        <% }) %>
        <div class="col-12"><button class="btn btn-sm btn-warning" type="submit"><%= booking.pricing.customPending ? 'Save settled price' : 'Update price' %></button></div>
      </form>
    </div>
  <% } %>

  <!-- Certificate fields -->
  <div class="card p-3">
    <h6 class="section-title">Certificate details</h6>
    <form class="row g-2 js-cert">
      <div class="col-md-4">
        <label class="form-label small">Free-chlorine residual (mg/L)</label>
        <input name="freeChlorineResidual" class="form-control form-control-sm" value="<%= booking.certificate?.freeChlorineResidual || '' %>" />
      </div>
      <div class="col-md-4">
        <label class="form-label small">Next service due</label>
        <input name="nextServiceDue" type="date" class="form-control form-control-sm" value="<%= booking.certificate?.nextServiceDue ? new Date(booking.certificate.nextServiceDue).toISOString().slice(0,10) : '' %>" />
      </div>
      <div class="col-md-4">
        <label class="form-label small">Technician</label>
        <input name="technician" class="form-control form-control-sm" value="<%= booking.certificate?.technician || '' %>" />
      </div>
      <div class="col-12"><button class="btn btn-sm btn-primary" type="submit">Save certificate details</button></div>
    </form>
  </div>
</div>
