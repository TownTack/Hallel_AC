<% layout('layouts/boilerplate') %>

<div class="row justify-content-center">
  <div class="col-lg-10">
    <div class="text-center mb-4">
      <h1 class="fw-bold" style="color: var(--hallel-navy)">
        Book a Tank Cleaning &amp; Disinfection Service
      </h1>
      <p class="text-muted">
        No-entry hygienic method &middot; Documented water-quality testing
        &middot; Service certificate on completion
      </p>
    </div>

    <form
      id="bookingForm"
      action="/booking"
      method="POST"
      class="card booking-card p-4 p-md-5"
      novalidate
    >
      <div class="row g-4">
        <!-- ================= Left: inputs ================= -->
        <div class="col-lg-7">
          <!-- Contact -->
          <h5 class="section-title mb-3">Your details</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label">Full name</label>
              <input
                name="clientName"
                class="form-control"
                required
                maxlength="120"
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">WhatsApp number</label>
              <input
                name="whatsapp"
                class="form-control"
                placeholder="05x xxx xxxx"
                required
              />
            </div>
            <div class="col-md-6">
              <label class="form-label"
                >Email <span class="text-muted">(optional)</span></label
              >
              <input name="email" type="email" class="form-control" />
            </div>

          </div>

          <!-- Service types (informational) -->
          <h5 class="section-title mb-3">Our Two Service Types</h5>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="service-type-card" tabindex="0">
                <h6>Standard</h6>
                <p>
                  Your tank is thoroughly cleaned and disinfected, and the old
                  stored water is fully drained — leaving it fresh, hygienic, and
                  ready to use.
                </p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="service-type-card" tabindex="0">
                <h6>Clean &amp; Preserve</h6>
                <p>
                  Your tank is thoroughly cleaned and disinfected while our crew
                  safely transfers your stored water into a clean holding tank —
                  treating, filtering, and pumping it back once the cleaning is
                  complete, so nothing goes to waste.
                </p>
              </div>
            </div>
          </div>

          <!-- Tanks -->
          <h5 class="section-title mb-3">Select your tank and service type</h5>
          <div id="tankRows" class="d-flex flex-column gap-2 mb-2"></div>
          <button
            type="button"
            id="addTank"
            class="btn btn-sm btn-outline-secondary mb-4"
          >
            + Add another tank
          </button>

          <!-- Location -->
          <h5 class="section-title mb-3">Your location</h5>
          <p class="text-muted small mb-2">
            Search your area or drop the pin on your home. Transport is free
            within <%= freeRadiusKm %> km of our base.
          </p>
          <div class="input-group mb-2">
            <input
              id="addressSearch"
              class="form-control"
              placeholder="Search area / estate…"
            />
            <button
              type="button"
              id="searchBtn"
              class="btn btn-outline-secondary"
            >
              Search
            </button>
            <button
              type="button"
              id="myLocationBtn"
              class="btn btn-outline-secondary"
            >
              Use my location
            </button>
          </div>
          <div id="map" class="mb-2"></div>
          <input type="hidden" name="lat" id="lat" />
          <input type="hidden" name="lng" id="lng" />
          <input type="hidden" name="address" id="address" />
          <input type="hidden" name="tanks" id="tanksInput" />
        </div>

        <!-- ============ When should we come? ============
             Comes AFTER tanks and location on purpose: the job length is
             derived from the cart and reachability from the map pin, so no
             time can be offered until both exist. -->
        <div class="mb-4" id="scheduleSection">
          <h5 class="section-title mb-3">Choose your arrival window</h5>

          <div id="schedulePrompt" class="text-muted small mb-2">
            Add your tanks and pick your location above, then we will show the
            times our crew can come.
          </div>

          <div id="slotPickerWrap" class="d-none">
            <div id="slotPicker"></div>
            <div id="chosenSlot" class="slot-chosen small mt-2 d-none"></div>
            <div id="durationNote" class="form-text"></div>
          </div>

          <!-- Custom-priced tanks have no estimable duration, so they skip live
               availability: the client asks for a day and we confirm the time. -->
          <div id="customDateWrap" class="d-none">
            <label class="form-label">Preferred service date</label>
            <input
              id="customDate"
              type="date"
              class="form-control"
              min="<%= new Date().toISOString().slice(0,10) %>"
            />
            <div class="form-text">
              This tank needs a site visit to price, so we will call you to agree
              a price and confirm an exact arrival time.
            </div>
          </div>

          <input type="hidden" name="startAt" id="startAt" />
          <input type="hidden" name="bookingDate" id="bookingDate" />
        </div>

        <!-- ================= Right: live summary ================= -->
        <div class="col-lg-5">
          <div class="summary-box p-4 sticky-top" style="top: 1rem">
            <h5 class="mb-3">Summary</h5>
            <div id="summaryLines" class="small mb-3 text-white-50">
              Add a tank to see pricing…
            </div>

            <div class="d-flex justify-content-between">
              <span>Tanks subtotal</span><span id="sumSubtotal">GHS 0.00</span>
            </div>
            <div id="minCalloutNote" class="small text-warning d-none">
              Minimum call-out fee applied.
            </div>

            <div class="d-flex justify-content-between mt-2">
              <span
                >Transport <span id="distanceNote" class="text-white-50"></span
              ></span>
              <span id="sumTransport"
                ><span class="badge badge-free">FREE</span></span
              >
            </div>

            <hr class="text-white-50" />
            <div class="d-flex justify-content-between align-items-center">
              <span>Total</span>
              <span class="total" id="sumTotal">GHS 0.00</span>
            </div>

            <div id="depositRow" class="d-flex justify-content-between mt-2 small d-none">
              <span>Due now to confirm</span><span id="sumDueNow">GHS 0.00</span>
            </div>
            <div id="depositNote" class="small text-white-50 d-none"></div>

            <!-- Pay now -->
            <div class="mt-4">
              <label class="form-label">Payment</label>
              <select name="payNowChoice" id="payNowChoice" class="form-select">
                <option value="later">Pay deposit now, balance on-site</option>
                <option value="now">Pay the full amount now</option>
              </select>
              <div id="payNote" class="small text-warning mt-2 d-none"></div>
            </div>

            <button
              type="submit"
              id="bookBtn"
              class="btn btn-light w-100 mt-4 fw-bold"
            >
              Book Now
            </button>
            <div id="customNote" class="small text-warning mt-2 d-none"></div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Config for the client script -->
<script type="application/json" id="bookingConfig">
  {
    "priceList": <%- JSON.stringify(priceList) %>,
    "baseLocation": <%- JSON.stringify(baseLocation) %>,
    "freeRadiusKm": <%= freeRadiusKm %>,
    "scheduling": <%- JSON.stringify(scheduling) %>,
    "commitmentDepositPct": <%= commitmentDepositPct %>
  }
</script>
<script defer src="/js/slot-picker.js"></script>
<script defer src="/js/booking.js"></script>
