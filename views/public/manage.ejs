<% layout('layouts/boilerplate') %>
<%
  const sch = booking.schedule || {};
  const hhmm = (d) => new Date(d).toISOString().slice(11, 16);
  const window = sch.startAt ? hhmm(sch.startAt) + ' – ' + hhmm(sch.windowEndAt || sch.startAt) : null;
  const cancelled = booking.jobStatus === 'cancelled' || booking.jobStatus === 'no_show';
  const done = booking.jobStatus === 'completed' || booking.jobCompleted;
  const manageBase = '/b/' + booking.reference + '/' + booking.manageToken;
%>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card booking-card p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <h2 class="fw-bold mb-1" style="color:var(--hallel-navy)">Your booking</h2>
          <p class="text-muted mb-0">Reference <strong><%= booking.reference %></strong></p>
        </div>
        <span class="badge rounded-pill <%= cancelled ? 'text-bg-danger' : (done ? 'text-bg-secondary' : 'text-bg-success') %>">
          <%= cancelled ? (booking.jobStatus === 'no_show' ? 'Missed' : 'Cancelled') : (done ? 'Completed' : 'Confirmed') %>
        </span>
      </div>

      <ul class="list-group list-group-flush text-start mb-3">
        <li class="list-group-item d-flex justify-content-between"><span>Name</span><strong><%= booking.clientName %></strong></li>
        <li class="list-group-item d-flex justify-content-between">
          <span>Service date</span>
          <strong><%= new Date(booking.bookingDate).toLocaleDateString('en-GB') %></strong>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span>Arrival window</span>
          <strong><%= window || 'We will call to confirm your time' %></strong>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span>Tanks</span>
          <strong><%= booking.tanks.map(t => t.quantity + 'x ' + t.label).join(', ') %></strong>
        </li>
        <% if (booking.pricing.customPending) { %>
          <li class="list-group-item d-flex justify-content-between"><span>Total</span><strong>A custom quote is required</strong></li>
        <% } else { %>
          <li class="list-group-item d-flex justify-content-between"><span>Total</span><strong>GHS <%= booking.pricing.total.toFixed(2) %></strong></li>
        <% } %>
        <% if (booking.payment.amountPaid > 0) { %>
          <li class="list-group-item d-flex justify-content-between"><span>Paid</span><strong>GHS <%= booking.payment.amountPaid.toFixed(2) %></strong></li>
        <% } %>
      </ul>

      <% if (cancelled) { %>
        <div class="alert alert-secondary small mb-0">
          This booking was cancelled<%= booking.cancellation && booking.cancellation.cancelledAt ? ' on ' + new Date(booking.cancellation.cancelledAt).toLocaleDateString('en-GB') : '' %>.
          <% if (booking.cancellation && booking.cancellation.refundStatus === 'pending') { %>
            Your deposit is queued for a refund — we will be in touch.
          <% } else if (booking.cancellation && booking.cancellation.depositForfeited) { %>
            As it was cancelled at short notice, the commitment deposit is not refundable.
          <% } %>
          <a href="/" class="alert-link">Make a new booking</a>.
        </div>

      <% } else if (!canChange) { %>
        <div class="alert alert-warning small">
          <%= blockedReason %>
          <% if (waNumber) { %>
            <a class="alert-link" target="_blank" rel="noopener"
               href="https://wa.me/<%= waNumber %>?text=<%= encodeURIComponent('Hi Hallel AquaCare, about booking ' + booking.reference + ':') %>">Message us on WhatsApp</a>
          <% } %>
        </div>

      <% } else { %>
        <p class="small text-muted">
          You can move or cancel this booking free of charge up to
          <strong><%= cutoffHours %> hours</strong> before the service
          (<%= hoursLeft %> hours left).
        </p>

        <div class="d-flex gap-2 flex-wrap mb-3">
          <button class="btn btn-outline-primary" type="button" id="showReschedule">Change my time</button>
          <button class="btn btn-outline-danger" type="button"
                  data-bs-toggle="modal" data-bs-target="#cancelModal">Cancel booking</button>
        </div>

        <div id="rescheduleBox" class="d-none">
          <h6 class="section-title mb-2">Pick a new arrival window</h6>
          <div id="slotPicker"></div>

          <form method="POST" action="<%= manageBase %>/reschedule" class="mt-3" id="rescheduleForm">
            <input type="hidden" name="startAt" id="newStartAt" />
            <div id="chosenBox" class="slot-chosen small d-none mb-2"></div>
            <button class="btn btn-primary" type="submit" id="confirmReschedule" disabled>
              Confirm new time
            </button>
          </form>
        </div>

        <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Cancel this booking?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form method="POST" action="<%= manageBase %>/cancel">
                <div class="modal-body">
                  <p class="mb-2">
                    Your <%= new Date(booking.bookingDate).toLocaleDateString('en-GB') %>
                    <%= window ? 'slot (' + window + ')' : 'booking' %> will be released
                    and offered to other customers.
                  </p>
                  <label class="form-label small">Reason (optional)</label>
                  <input class="form-control" name="reason" maxlength="200" placeholder="e.g. travelling that week" />
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep my booking</button>
                  <button type="submit" class="btn btn-danger">Yes, cancel it</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% if (!cancelled && canChange) { %>
<script src="/js/slot-picker.js" defer></script>
<script defer>
  document.addEventListener('DOMContentLoaded', function () {
    var box = document.getElementById('rescheduleBox');
    var startInput = document.getElementById('newStartAt');
    var chosen = document.getElementById('chosenBox');
    var confirmBtn = document.getElementById('confirmReschedule');
    var picker = null;

    document.getElementById('showReschedule').addEventListener('click', function () {
      box.classList.remove('d-none');
      if (picker) return;
      picker = HallelSlotPicker.create({
        root: document.getElementById('slotPicker'),
        promptText: 'Pick a date to see the times we can come.',
        load: function (from, to) {
          return fetch('<%= manageBase %>/availability', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ from: from, to: to }),
          }).then(function (r) { return r.json(); });
        },
        onSelect: function (startAt, label, dateKey) {
          startInput.value = startAt;
          chosen.textContent = 'New time: ' + dateKey + ', ' + label;
          chosen.classList.remove('d-none');
          confirmBtn.disabled = false;
        },
      });
      picker.refresh();
    });
  });
</script>
<% } %>
